# Скопіюйте у файл .env і за потреби змініть. Файл .env не додається в Git.
# Значення нижче синтетичні й придатні лише для локального стенда.
RABBITMQ_USER=fitshed
RABBITMQ_PASSWORD=fitshed-local-only

# Адреса брокера для публікатора й споживача (має відповідати значенням вище)
FITSHED_AMQP_URL=amqp://fitshed:fitshed-local-only@localhost:5672/%2F
